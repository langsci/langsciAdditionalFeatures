msgid "plugins.generic.langsciAdditionalFeatures.displayName"
msgstr "Language Science Press Zusatzfunktionen"

msgid "plugins.generic.langsciAdditionalFeatures.description"
msgstr "Stellt zusätzliche, einzeln aktivierbare Funktionen für Language Science Press bereit."

msgid "plugins.generic.langsciAdditionalFeatures.settings.groupLabel"
msgstr "Zusatzfunktionen"

msgid "plugins.generic.langsciAdditionalFeatures.settings.groupDescription"
msgstr "Aktivieren oder deaktivieren Sie die Zusatzfunktionen für diesen Verlag."

msgid "plugins.generic.langsciAdditionalFeatures.settings.enabledFeatures"
msgstr "Aktivierte Funktionen"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.settingsLabel"
msgstr "Rezensionen: Stellt vorhandene Rezensionslinks für die Buchseite bereit."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.menu"
msgstr "Rezensionen"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.manage"
msgstr "Rezensionen verwalten"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.add"
msgstr "Rezension hinzufügen"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.edit"
msgstr "Bearbeiten"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.delete"
msgstr "Löschen"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.cancel"
msgstr "Abbrechen"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.save"
msgstr "Speichern"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.confirmDelete"
msgstr "Diese Rezension löschen?"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.empty"
msgstr "Für diese Einreichung liegen keine Rezensionen vor."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.loading"
msgstr "Wird geladen..."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.name"
msgstr "Linkname"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.url"
msgstr "Rezensions-URL"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.reviewer"
msgstr "Rezensent/in"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.date"
msgstr "Datum (JJJJMMTT)"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.quotation"
msgstr "Zitat"

msgid "plugins.generic.langsciAdditionalFeatures.reviews.requestFailed"
msgstr "Die Anfrage zu den Rezensionen ist fehlgeschlagen. Bitte versuchen Sie es erneut."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.saved"
msgstr "Rezension gespeichert."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.deleted"
msgstr "Rezension gelöscht."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.method"
msgstr "Diese Anfragemethode ist nicht zulässig."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.request"
msgstr "Die Anfrage wurde nicht autorisiert. Laden Sie die Seite neu und versuchen Sie es erneut."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.notFound"
msgstr "Die Rezension wurde für diese Einreichung nicht gefunden."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.invalid"
msgstr "Die Rezension enthält ungültige Felder."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.length"
msgstr "Linkname, URL, Rezensent/in und Datum dürfen jeweils höchstens 255 Zeichen lang sein."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.name"
msgstr "Geben Sie einen Linknamen ein."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.url"
msgstr "Geben Sie eine gültige HTTP- oder HTTPS-URL ein."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.date"
msgstr "Geben Sie ein gültiges Datum im Format JJJJMMTT ein oder lassen Sie das Feld leer."

msgid "plugins.generic.langsciAdditionalFeatures.reviews.error.publication"
msgstr "Eine Rezension kann nicht hinzugefügt werden, da diese Einreichung keine aktuelle Publikation hat."

msgid "plugins.generic.langsciAdditionalFeatures.pubState.settingsLabel"
msgstr "Publikationsstatus: Ermöglicht es, den Status einer Publikation als Forthcoming, Published oder Superseded zu definieren."

msgid "plugins.generic.langsciAdditionalFeatures.pubState.fieldLabel"
msgstr "Publikationsstatus"

msgid "plugins.generic.langsciAdditionalFeatures.pubState.label.forthcoming"
msgstr "Forthcoming"

msgid "plugins.generic.langsciAdditionalFeatures.pubState.label.published"
msgstr "Published"

msgid "plugins.generic.langsciAdditionalFeatures.pubState.label.superseded"
msgstr "Superseded"

msgid "plugins.generic.langsciAdditionalFeatures.pubState.fieldDescription"
msgstr "Die Auswahl von Forthcoming entfernt das Publikationsdatum."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.settingsLabel"
msgstr "Remote-Kapitel: Ermöglicht externe Galerien und Kapitelnummerierung in Kapiteldefinitionen."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.remoteURLLabel"
msgstr "Beschriftung des Download-Buttons."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.chapterLabel"
msgstr "Kapitel"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.chapterNumber"
msgstr "Nummer"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.excludeFromCount"
msgstr "Dieses Kapitel nicht mitzählen"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.title"
msgstr "Kapitelnummern-Versatz festlegen"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.label"
msgstr "Kapitelnummern-Versatz"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.description"
msgstr "Diese Zahl wird zur Position jedes Kapitels addiert, um die angezeigte Nummer zu erhalten. Bei einem Versatz von 2 wird das erste Kapitel als Kapitel 3 angezeigt."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.invalid"
msgstr "Bitte geben Sie eine ganze Zahl ein."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.defaultLabel.label"
msgstr "Standard-Kapitelbeschriftung"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.defaultLabel.description"
msgstr "Füllt die Beschriftung neuer externer Kapitelgalerien vorab aus."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.numbering.description"
msgstr "Kapitelnummer = Versatz + Position des Kapitels innerhalb aller Kapitel; als „Dieses Kapitel nicht mitzählen“ markierte Kapitel werden übersprungen. Bei der Veröffentlichung werden Nummern dauerhaft in die Beschriftungen externer Kapitel-Links übernommen, deren Beschriftung die Standard-Kapitelbeschriftung und keine Ziffer enthält. Danach werden sie nicht mehr neu berechnet und müssen manuell bearbeitet werden."
