msgstr "Do not count this chapter"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.title"
msgstr "Set chapter number offset"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.label"
msgstr "Chapter number offset"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.description"
msgstr "This number is added to the position of each chapter to get its displayed number. With an offset of 2, the first chapter is displayed as chapter 3."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.offset.invalid"
msgstr "Please enter a whole number."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.defaultLabel.label"
msgstr "Default chapter label"

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.defaultLabel.description"
msgstr "Pre-fills the label of new remote chapter galleys."

msgid "plugins.generic.langsciAdditionalFeatures.remoteChapters.numbering.description"
msgstr "Chapter number = offset + position of the chapter among all chapters, skipping chapters marked \"Do not count this chapter\". When the publication is published, the numbers are written permanently into the labels of remote chapter links whose label contains the default chapter label and no digit. After that, they are no longer recalculated and need to be edited manually."
